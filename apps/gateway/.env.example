# --- hermit-ui gateway (runs on the machine hosting the agents) ---
# Copy to `.env` and fill in. Never commit the real `.env` (it is gitignored).

# URL of the dashboard this gateway pushes collected state to. Required.
DASHBOARD_URL="https://dash.example.com"

# Absolute path to the directory that holds agent workspaces. Required —
# the gateway refuses to start without it (a wrong-but-present path yields a
# silently empty fleet, which is much harder to spot than a refusal).
AGENTS_ROOT="/path/to/agents"

# Shared machine key for authenticating to the dashboard /api/sync routes.
# Must match HERMIT_KEY on the dashboard side. (ASST_KEY is accepted as a
# legacy alias.)
# HERMIT_KEY=

# Root of the Claude Code project dirs (usually ~/.claude/projects).
# Optional; defaults to $HOME/.claude/projects.
# PROJECTS_ROOT=

# --- optional: where the CLIs live, when they are not on a daemon's PATH ---
# Explicit path to the `claude` binary. Optional; the gateway searches PATH plus
# the usual install dirs (~/.local/bin, /opt/homebrew/bin on macOS,
# ~/.npm-global/bin and /snap/bin on Linux). Run `npm run doctor` to see what it
# found on this machine.
# HERMIT_CLAUDE_BIN=

# --- optional: the codex backend (`codex-exec`) ---
# Explicit path to the `codex` binary. Optional; the SDK finds it on PATH.
# Auth is codex's own — run `codex login` as the user the gateway runs as.
# HERMIT_CODEX_BIN=
# Reasoning effort for codex sessions (minimal|low|medium|high|xhigh).
# Optional; codex's own config decides when unset.
# HERMIT_CODEX_EFFORT=
# Sandbox and approval posture for codex sessions. The defaults
# (danger-full-access / never) match the claude path's
# --dangerously-skip-permissions: a dashboard session has no TTY, so anything
# that can prompt for approval would hang until it timed out.
# HERMIT_CODEX_SANDBOX=
# HERMIT_CODEX_APPROVAL=

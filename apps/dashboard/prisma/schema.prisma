// asst-dashboard schema
// Each Machine has an opaque access key (bcrypt-hashed). Agents, events,
// and LaunchAgent snapshots are scoped to a machine — supports multi-host
// later by issuing additional Machine rows, but v1 ships with one row.

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Machine {
  id        String    @id @default(cuid())
  name      String    @unique
  hostname  String?
  alias     String? // user-set display name shown in the dashboard (workspace switcher); falls back to name
  keyHash   String
  keyPrefix String
  createdAt DateTime  @default(now())
  lastSeen  DateTime?

  // Hard quotas configured per machine — gateway fills `used`, dashboard
  // computes pct against these. Null disables the bar in UI.
  fiveHourLimitUsd Float?
  weeklyLimitUsd   Float?

  // ── Session cleanup (docs/session-cleanup-design.md) ──
  // THE session-lifecycle dial. A session idle longer than this many days is
  // archived — out of the sidebar and asleep — by the Brain's nightly dream and by
  // the gateway's hourly sweep. null = off, which also means nothing ever puts a
  // session to sleep, so treat a null here as "this machine will hold every
  // conversation's ~500MB until someone intervenes".
  //
  // Replaced `idleReapHours` (migration 20260809210000). That was a second
  // automatic mechanism with its own threshold whose only effect — hibernate —
  // is a strict subset of archiving's, so all it could produce was the
  // half-tidied state of a sleeping session still sitting in the sidebar.
  //
  // Only ever drives the REVERSIBLE tier: nothing here can trash or purge a
  // session, which stays a deliberate human click.
  cleanupIdleDays Int?
  // How long a trashed session sits recoverable before the gateway purges it.
  trashRetainDays Int @default(14)
  // Audit trail for the reversible half of cleanup. The destructive half audits
  // itself — every binned session carries its own trashedAt + trashReason and is
  // sitting right there in the trash view — but a sweep that quietly archived 30
  // conversations would otherwise leave no trace at all. Shape:
  // `{ slept, archived, trashed, auto }`.
  lastCleanupAt      DateTime?
  lastCleanupSummary Json?

  // Which backends this machine offers, edited from Settings → Backends.
  // Shape: `{ disabled: string[], instances: BackendInstance[], dshSource? }`
  // — see lib/backends.ts.
  //
  // `instances` are the backends the user COMPOSED: one harness (pi, prime,
  // dsh) paired with one credential from `modelProviders`. The two built-in
  // backends — Claude Code and Codex, each on its own subscription — are not
  // stored here at all; they always exist and only appear in `disabled`.
  //
  // Stored as the DISABLED set, not the enabled one, so "nothing configured"
  // means "the two built-ins, both on", which is exactly what a fresh machine
  // should offer.
  //
  // Per machine because availability genuinely is: codex needs `codex login` on
  // that host, and a composed backend needs its harness installed there.
  backendsConfig Json?

  // The machine's watchdog knobs, edited from Settings → Watchdogs. One JSON
  // object with a section per watchdog (stuck / unanswered / hostRed /
  // strayReaper / chromeReaper / gatewayWatch) — see lib/watchdog-config.ts.
  // Per machine because the right threshold genuinely is: a box that renders
  // all night tolerates load a chat-first box should not. Read by the
  // dashboard sweeps directly, by the gateway via machines.pollWatchdogConfig,
  // and by the launchd watchdog through the config.env its gateway writes.
  watchdogConfig Json?

  // The machine's model credentials, edited from Settings → Models. A JSON
  // ARRAY of { id, label, provider, api, baseUrl, models[], defaultModel,
  // secretKey, modelLimits } — see lib/model-credentials.ts.
  //
  // `secretKey` is the NAME of a secret in the machine's store, never a value.
  // Nothing in here authenticates a subscription: Claude Code and Codex do that
  // themselves, on the machine.
  modelProviders Json?

  // What Claude Code on THIS machine says it can run — the array
  // `supportedModels()` returns, `[{ value, displayName, description }]`.
  // Pushed by the gateway when a claude-sdk session boots (POST
  // /api/sync/claude-models); read by the chat header's model picker.
  //
  // A cache of the machine's own answer, never a list the dashboard curates:
  // the aliases in it (`opus[1m]`, `sonnet`) are resolved by the CLI, and which
  // model they mean changes under us. null = no gateway has reported yet, and
  // the picker falls back to lib/claude-models.ts.
  claudeModels Json?

  // Legacy pi-runtime machine config, superseded by `modelProviders`. Still
  // written by nothing and read only by the compatibility projection that keeps
  // a lagging gateway working until it restarts (machines.pollPiConfig).
  // { provider, baseUrl, api, models[], secretKey, image: { enabled, provider,
  //   apiKeySecret, ocrModel, describeModel, prompt } }
  piConfig Json?

  agents              Agent[]
  crons               Cron[]
  usageHourly         UsageHourly[]
  codexUsage          CodexUsage?
  kimiUsage           KimiUsage?
  usageWindows        UsageWindow[]
  chatSessions        ChatSession[]
  agentRequests       AgentRequest[]
  globalSkills        GlobalSkill[]
  globalSkillRequests GlobalSkillRequest[]
  machineRequests     MachineRequest[]
  fileTransfers       FileTransfer[]
  planUsage           PlanUsage?
  globalMemory        GlobalMemory?
  shareLinks          AgentShareLink[]
  hostStat            HostStat?
  knowledgeBases      KnowledgeBase[]
  pushDevices         PushDevice[]
  liveActivities      LiveActivity[]
  sessionGroups       SessionGroup[]
  machineAlerts       MachineAlert[]
}

// Latest host-resource snapshot for a machine — RAM / swap / load / cpu, pushed by
// the gateway host-stat tick (~30s) and upserted (one row per machine, no history).
// Drives the dashboard Host-health panel + the red-pressure notification. Health
// colour keys on free-RAM + load, NOT swap-used: macOS lazily reclaims swapfiles so
// swap-used stays stale after pressure clears (macmini1 incident report §3).
model HostStat {
  machineId   String    @id
  ramTotalMb  Int?
  ramFreeMb   Int?
  swapUsedMb  Int?
  swapTotalMb Int?
  loadAvg1    Float?
  cpuCount    Int?
  // Per-agent Chrome footprint (resource governance): chromeCount = main browser
  // processes (≈ one per agent), chromeRssMb = total RSS of all Chrome procs.
  chromeCount Int?
  chromeRssMb Int?
  // Claude transcripts on disk (docs/session-cleanup-design.md). Report-only:
  // ~/.claude/projects holds every claude run on the host, the human's own
  // terminal sessions included, so nothing sweeps it — a transcript is only ever
  // deleted at purge time, while the row naming it still exists.
  transcriptTotalMb    Int?
  transcriptCount      Int?
  transcriptOrphanMb   Int?
  transcriptOrphanCount Int?
  // This gateway process's boot time, reported on the 30s host-stat push.
  // "Gateway last restarted" on Settings → Watchdogs reads this; null until
  // the machine's gateway next restarts on code that reports it.
  gatewayStartedAt DateTime?
  sampledAt   DateTime?

  // Red-pressure alert (A4). redAlertAt is stamped when the host CROSSES into red
  // (set once, not every tick) and cleared on recovery to ≤amber; alertReadAt is
  // stamped when the user reads the inbox. The notifications feed shows a host
  // alert iff redAlertAt != null AND (alertReadAt == null OR alertReadAt <
  // redAlertAt) — so a sustained red shows once, a new episode re-alerts.
  redAlertAt  DateTime?
  alertReadAt DateTime?

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
}

// A machine-health alert raised by something that noticed a machine misbehave:
// the stuck-message sweep (server/machine-alerts.ts), the on-host gateway
// watchdog (scripts/gateway-watch.sh), or a gateway tick that had to act
// (stray-reaper killing leaked browsers). One OPEN row per (machineId, kind) —
// re-occurrences update it rather than stacking — so a condition that holds for
// six hours is one banner, not seventy-two.
//
// Lifecycle: condition alerts (stuck-messages) are resolved by the sweep that
// raised them when the condition clears. Episodic alerts (everything reported
// over /api/sync/machine-alert) carry expiresAt and lapse on their own when the
// reporter stops re-reporting. `dismiss` (alerts.dismiss) stamps resolvedAt by
// hand. "Open" = resolvedAt IS NULL AND (expiresAt IS NULL OR expiresAt > now).
model MachineAlert {
  id         String    @id @default(cuid())
  machineId  String
  kind       String // stuck-messages | gateway-wedged | high-load | chrome-leak | gateway-resurrected | gateway-start-failed
  message    String
  count      Int       @default(1)
  // Last time this alert pushed, so a persistent condition re-pushes at most
  // every REPUSH_MS instead of every sweep/tick.
  pushedAt   DateTime?
  // Set by dismiss: the human has seen it — stay quiet (no re-open, no push)
  // until this passes, even if the condition persists. Cleared only by time.
  snoozedUntil DateTime?
  expiresAt  DateTime?
  // Where tapping the banner / push should land. The stuck sweep sets it to the
  // oldest stuck session's chat; watchdog/reaper reports default to /watchdogs.
  linkPath   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId, kind, resolvedAt])
}

// A per-agent share link: a scoped credential that grants access to ONLY this
// agent (chat / files / detail / loop·cron / terminal) and hides every other
// agent + all machine-global management. The token is bcrypt-hashed like a
// Machine key (keyHash + an indexed keyPrefix for fast lookup); its plaintext
// (`shr_…`) is shown to the owner ONCE at generate time. Revoke = delete the
// row; regenerate = overwrite the hash. One active link per (machine, agent).
model AgentShareLink {
  id         String    @id @default(cuid())
  machineId  String
  agentName  String
  keyHash    String
  keyPrefix  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([machineId, agentName])
  @@index([keyPrefix])
}

// File Station: a large file the dashboard uploaded for delivery to a machine at
// `destPath`. The dashboard can't reach the gateway host's FS, so the bytes land
// on the dashboard's disk (UPLOAD_DIR/file-station/<id>.bin); the gateway polls,
// downloads them, writes to destPath (optionally unzipping), then acks — and the
// dashboard deletes the temp file. Up to 300 MB; archives allowed.
model FileTransfer {
  id          String    @id @default(cuid())
  machineId   String
  machine     Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  filename    String
  destPath    String    @db.Text // where on the machine to write it
  size        Int // bytes
  unzip       Boolean   @default(false) // extract into destPath (zip only)
  status      String    @default("pending") // pending | running | done | error
  error       String?   @db.Text
  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([machineId, status])
}

// Real Claude Max plan consumption, scraped from `claude /usage` by the gateway
// (the only accurate source for the true 5h/weekly window %; UsageWindow/
// UsageHourly are ccusage cost ESTIMATES). One row per machine, upserted.
model PlanUsage {
  machineId        String   @id
  machine          Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  sessionPct       Int? // 5-hour rolling window % used
  weekPct          Int? // weekly (all models) % used
  weekSonnetPct    Int? // weekly Sonnet sub-limit % used
  sessionResetText String? // e.g. "1:30pm (Asia/Shanghai)"
  weekResetText    String? // e.g. "Jun 3 at 7am (Asia/Shanghai)"
  capturedAt       DateTime @default(now())
}

// Dashboard-requested agent lifecycle ops (create / delete). The dashboard
// can't touch the gateway host's filesystem, so it queues a request here; the
// Mac-side gateway polls, scaffolds-from-template / rm -rf's the agent dir,
// then acks. Mirrors the ChatSession.restartRequestedAt round-trip.
// Codex plan consumption, read from app-server `account/rateLimits/read`.
//
// Deliberately NOT merged into PlanUsage: Codex can source its 5-hour and weekly
// values from different metered buckets, while Claude's pair is one scraped
// text panel. The source IDs below keep that distinction explicit.
model CodexUsage {
  machineId         String    @id
  machine           Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  // Legacy single-window columns retained while older gateways roll forward.
  usedPercent       Float?
  windowMinutes     Int?
  resetsAt          DateTime?
  // The two slots rendered by the dashboard, with their actual metered bucket.
  fiveHourPct       Float?
  fiveHourResetsAt  DateTime?
  fiveHourLimitId   String?
  fiveHourLimitName String?
  weekPct           Float?
  weekResetsAt      DateTime?
  weekLimitId       String?
  weekLimitName     String?
  planType          String?
  // Legacy per-day token totals. Retained for sync compatibility; no longer rendered.
  daily             Json?
  capturedAt        DateTime  @default(now())
}

// Kimi Code subscription quota, read from Moonshot's own endpoint by the
// gateway (`GET <baseUrl>/v1/usages` with the credential's API key — the same
// numbers the Kimi CLI's `/usage` command shows).
//
// A third vendor, a third shape, and again NOT merged into PlanUsage or
// CodexUsage. Kimi reports a 7-day subscription quota AND a rolling rate window
// as two separate rows with their own reset clocks, plus a concurrency cap and
// a pay-as-you-go wallet that takes over when the quota runs out. None of those
// has a column to live in on the other two rows.
//
// The quota is an ACCOUNT figure, not a machine one — two machines sharing one
// Kimi key report the same numbers. Keyed by machine anyway, exactly as
// PlanUsage is for a Claude subscription, because that is where the credential
// that can read it lives.
model KimiUsage {
  machineId    String  @id
  machine      Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  // Which Settings → Models credential answered. A machine can hold more than
  // one Kimi key, and a figure with no idea which account it describes is not
  // something anyone can act on.
  credentialId String?
  // Membership tier as the API names it (e.g. LEVEL_ADVANCED), and the
  // human-facing name when /me supplies one (Allegro).
  planLevel    String?
  planName     String?
  // The subscription quota — refreshes every 7 days from the subscription date
  // and does not roll over. `used`/`limit` are the vendor's own units; the UI
  // renders the RATIO, which is the only reading that is stable if they change.
  periodUsed     Int?
  periodLimit    Int?
  periodResetsAt DateTime?
  // The rolling rate windows, `[{ minutes, used, limit, resetsAt }]`. JSON
  // rather than columns because the endpoint returns a LIST — one 5-hour window
  // today, and nothing promises it stays one.
  windows        Json?
  // Concurrent requests allowed. Not a quota, but it is the third number that
  // makes a 429 explicable.
  parallelLimit  Int?
  // "Extra Usage" — the pay-as-you-go balance that keeps requests flowing after
  // the quota is spent. Null when the account has none, which is the common case.
  extraBalanceCents Int?
  extraCurrency     String?
  capturedAt   DateTime @default(now())
}

model AgentRequest {
  id          String    @id @default(cuid())
  machineId   String
  machine     Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  kind        String // "create" | "delete" | "edit" | "restore" | "purge"
  agentName   String
  persona     String? // create: the agent's one-line purpose ({{PERSONA}})
  // edit: which file to write + its new content. `target` is an opaque slug
  // mapped to an allow-listed relative path on the gateway side (see
  // agent-lifecycle.ts); raw paths are never accepted from the dashboard.
  target      String?
  content     String?   @db.Text
  refs        Json? // install bundle: sub-files [{ path, content }] written alongside SKILL.md
  status      String    @default("pending") // pending | done | error
  error       String?   @db.Text
  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([machineId, status])
}

// Machine-global skills under ~/.claude/skills/ on the gateway host — shared by
// every Claude Code session on that machine, not scoped to an agent. The gateway
// scans the directory and pushes; the FILESYSTEM is the source of truth (the
// sync upserts what's present and deletes what's gone). Mutations round-trip via
// GlobalSkillRequest, mirroring AgentRequest.
model GlobalSkill {
  id          String   @id @default(cuid())
  machineId   String
  machine     Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  name        String // directory name under ~/.claude/skills/
  description String?  @db.Text
  content     String?  @db.Text // SKILL.md text; null for bundles
  refs        Json     @default("[]") // Array<{ name, content }> from references/
  source      String   @default("manual") // manual | git | plugin
  isBundle    Boolean  @default(false) // a plugin/framework with nested skills/ — read-only
  subSkills   String[] @default([]) // bundle: nested sub-skill names
  fileCount   Int      @default(0)
  metadataAt  DateTime @default(now())

  // Provenance when this machine skill was installed from the marketplace.
  marketSkillId String?
  marketVersion String?

  @@unique([machineId, name])
}

// Dashboard-requested global-skill lifecycle ops. The dashboard can't touch the
// gateway host's filesystem, so it queues a request here; the Mac-side gateway
// polls, writes/removes ~/.claude/skills/<name>/, then acks. Mirrors AgentRequest.
model GlobalSkillRequest {
  id          String    @id @default(cuid())
  machineId   String
  machine     Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  kind        String // "create" | "edit" | "delete"
  skillName   String
  content     String?   @db.Text // create / edit: full SKILL.md
  refs        Json? // install bundle: sub-files [{ path, content }] written alongside SKILL.md
  status      String    @default("pending") // pending | done | error
  error       String?   @db.Text
  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([machineId, status])
}

// Global memory — a per-MACHINE shared note loaded by every agent on that host.
// Edited in the dashboard (Settings → Global Memory) for the active machine; that
// machine's gateway pulls it and keeps a managed section in its ~/.claude/CLAUDE.md,
// which Claude Code auto-injects into every session. One row per machine.
model GlobalMemory {
  machineId String   @id
  machine   Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  content   String   @default("") @db.Text
  enabled   Boolean  @default(true) // off = the gateway drops the block; agents stop loading it (content kept)
  updatedAt DateTime @updatedAt
}

// A knowledge base — a per-MACHINE library entry. `intro` is the always-loaded
// summary (→ materialized SKILL.md `description`); `docs` are markdown files read on
// demand. Attached to agents via AgentKnowledgeBase; the gateway materializes each
// attached KB as a Claude Code skill under <agent>/.claude/skills/kb-<slug>/.
// See docs/knowledge-base-design.md.
model KnowledgeBase {
  id               String   @id @default(cuid())
  machineId        String
  machine          Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  slug             String // dir name → .claude/skills/kb-<slug>/
  name             String
  intro            String   @default("") @db.Text // always-loaded summary → SKILL.md description
  autoIntro        Boolean  @default(true) // Brain's dream may rewrite intro when true
  introUpdatedAt   DateTime @default(now()) // bumped when intro changes
  contentUpdatedAt DateTime @default(now()) // bumped on any doc create/update/delete/reorder
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  docs        KnowledgeDoc[]
  attachments AgentKnowledgeBase[]

  @@unique([machineId, slug])
}

// One markdown document inside a knowledge base. `filename` is the stable on-disk
// name under kb-<slug>/docs/, assigned at creation and unchanged by title edits.
model KnowledgeDoc {
  id              String        @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  title           String
  filename        String // <filename>.md within kb-<slug>/docs/, unique per KB
  content         String        @default("") @db.Text // markdown
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([knowledgeBaseId, filename])
}

// Attachment: which agent has which knowledge base. Mirrors AgentSkillInstall.
// Deleting the KB (or its machine, transitively) cascades these away.
model AgentKnowledgeBase {
  machineId       String
  agentName       String
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@id([machineId, agentName, knowledgeBaseId])
  @@index([machineId, agentName])
}

// DB→disk materialization queue (mirrors GlobalSkillRequest). The dashboard enqueues
// a request; the machine's gateway polls, writes/removes <agent>/.claude/skills/
// kb-<slug>/, then acks. `payload` carries the full KB snapshot for `materialize`.
model KnowledgeBaseRequest {
  id         String    @id @default(cuid())
  machineId  String
  agentName  String // whose .claude/skills/ to write
  slug       String // kb-<slug>
  kind       String // "materialize" | "remove"
  payload    Json? // { name, intro, docs: [{ filename, title, content }] }
  status     String    @default("pending") // pending | done | error
  error      String?   @db.Text
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([machineId, status])
}

// Machine-level ops the dashboard queues for the gateway to run on its host:
// "upgrade-claude" (runs `claude upgrade`) and "restart-all-sessions" (drives
// the existing per-session restart across every live session, staggered). These
// touch no agent files — the gateway polls, executes, writes `output` back, acks.
model MachineRequest {
  id          String    @id @default(cuid())
  machineId   String
  machine     Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  kind        String // "upgrade-claude" | "restart-all-sessions" | "login-claude-account"
  status      String    @default("pending") // pending | running | needs-human | done | error
  output      String?   @db.Text // stdout / summary surfaced in the ops panel
  error       String?   @db.Text
  // Short-lived secret input for login-claude-account (sanitized account JSON:
  // email + mailToken + optional emailPassword; the `sk` is dropped client-side).
  // The gateway NULLs this the instant it claims the request — it rests in the
  // DB only for the seconds between enqueue and claim. Never logged/redacted out.
  payload     String?   @db.Text
  requestedAt DateTime  @default(now())
  // When the gateway CLAIMED it (its first `running` ack), stamped server-side
  // by machines.ackRequest. How long an op has been running is measured from
  // here, not from requestedAt: a request queued while the machine was offline
  // can sit pending for hours, and ageing it from when it was asked would make
  // it look stale the moment it finally started.
  startedAt   DateTime?
  resolvedAt  DateTime?

  @@index([machineId, status])
}

// Direct dashboard→agent chat. One ChatSession = one happy/claude conversation
// scoped to (machine, agentName). Multiple sessions per agent allowed (each
// gets its own claude `<uuid>.jsonl` underneath).
model ChatSession {
  id                String    @id @default(cuid())
  machineId         String
  machine           Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  agentName         String
  title             String?
  // Who wrote `title`. Machine-generated titles may be refreshed as the
  // conversation grows; a title the USER typed is never touched again.
  // See server/session-title.ts.
  titleAuto         Boolean   @default(false)
  // How many messages the USER had sent when the auto title was last generated.
  // The title is derived from the user's own messages, so this is what "has
  // anything new been asked?" is measured in — counting every row would let
  // tool traffic alone trip a refresh.
  titleUserMsgCount Int?
  // Denormalized sidebar preview: the first user message's first text block,
  // whitespace-collapsed + sliced to 120 chars. Set once by chat.send (+ a one-time
  // backfill) so listSessions/getSession read a column instead of a per-session
  // first-user-message subquery (was ~0.5–0.9s for 40 sessions). NULL = not yet
  // derived (image-only first message, or pre-backfill) → UI falls back to agentName.
  preview           String?
  // How this session was created. 'dispatch' = opened by Brain's MCP `dispatch`
  // tool (one-shot delegation to another agent); NULL = a normal user-opened
  // chat. The /brain/dispatch page filters on this structural marker instead of
  // the title prefix, so a dispatch with a custom title is still recognized.
  origin            String?
  // Which backend runs THIS session. null = inherit the agent's default.
  // Chosen when the session is opened, so one agent can answer a throwaway
  // question on a cheap model and do real work on Claude without being
  // reconfigured. See docs/pi-runtime-design.md.
  runtime           String?
  runtimeProvider   String?
  runtimeModel      String?
  // Which pi MODE runs this session — the prompt/skill/tool recipe the child is
  // spawned with (ops, coding, research, …). Only meaningful for runtime
  // 'pi-rpc'; claude-tmux ignores it. null = inherit the agent's, then 'coding'.
  // See docs/pi-modes-design.md.
  runtimeMode       String?
  // Pure-chat session: the child is spawned with a READ-ONLY tool surface — it
  // can look at files and search the web, but cannot write, edit, run commands
  // or spawn sub-agents. Chosen when the session is opened (it is a spawn-time
  // property of the child, not a permission checked per call), so flipping it
  // later only takes effect on the next spawn.
  //
  // Every backend enforces this with its OWN mechanism — there is no shared
  // one, because no backend's write tools are forwarded by us; they all ship
  // inside the CLI. See docs/chat-only-mode.md for the per-backend table.
  // prime is the one backend that cannot honour it usefully.
  chatOnly          Boolean   @default(false)
  claudeSessionId   String? // populated by gateway once SDK boots
  startedAt         DateTime  @default(now())
  lastMessageAt     DateTime?
  // Per-session "last read" stamp — when the user last viewed this session in
  // chat. Drives the red "unread" dot (unread = lastMessageAt > lastReadAt).
  // Server-side (was client-only localStorage) so read-state syncs across every
  // device. Stamped by chat.markRead from the open chat pane.
  lastReadAt        DateTime?
  closedAt          DateTime? // null = active, gateway listens; non-null = archived
  // User "hide" — drops a noisy chat from the sidebar recents list (purely a UI
  // filter; the session keeps running). A "show hidden" toggle reveals them.
  // Server-side (not localStorage) so a hide syncs across devices, like lastReadAt.
  hiddenAt          DateTime?
  // User-requested stop signal for the in-flight turn. Set by chat.cancelTurn,
  // cleared by gateway via chat.ackCancel once the child process is killed.
  cancelRequestedAt DateTime?

  // User-requested session restart. Set by chat.requestSessionRestart; gateway
  // kills the tmux pane (`hermit-<sessionId>`) so the next user message
  // respawns claude with `--resume <claudeSessionId>` (history preserved).
  // Cleared by chat.ackSessionRestart once the pane is gone.
  restartRequestedAt DateTime?

  // ── Per-session runtime state (pushed by gateway session-snapshot tick) ──
  // Each ChatSession is its own claude process inside its own tmux pane
  // (`hermit-<sessionId>`). The dashboard's chat header + the agent-detail
  // sheet's session list both render from these columns.
  pid               Int?
  alive             Boolean   @default(false)
  state             String?
  contextTokens     Int?
  outputTokens      Int?
  lastActivity      DateTime?
  transcriptPath    String?
  lastUserPrompt    String?   @db.Text
  lastAssistantText String?   @db.Text
  // When a `/loop` iteration last reported a round into this session — an
  // assistant message whose text carries the skill's `↻ loop … run N` marker.
  // Compared against lastReadAt by the status dot: a round is a FINISHED piece
  // of work, so an unread one outranks the amber "a background task is still
  // running" state that would otherwise hold the session all day. Cannot be
  // derived from lastMessageAt or preview — both move with every later message,
  // and a looping session says dozens of things between rounds.
  lastLoopRoundAt   DateTime?
  // Loop / scheduled-task state, pushed alongside the other runtime fields.
  // The agent's `cron` skill rewrites <AGENT_DIR>/.loop-state.json every time
  // a /loop, /schedule, CronCreate, or CronDelete fires; the gateway forwards
  // whatever it finds on each session-snapshot tick. Shape is open:
  // `{ loops: [...], schedules: [...], updatedAt: <iso> }`. Dashboard renders
  // a small chip in the chat header from it.
  loopState         Json?
  // What the session is doing right now, when its backend can say: the tool and
  // how long it has been on it, a subagent, an API retry it is waiting out.
  // Written by the same session-snapshot tick as `state`, and NULL the moment
  // the session is idle — a stale chip is worse than no chip. Opaque JSON like
  // loopState: the shape is the gateway's (RuntimeActivity), the dashboard only
  // renders it. See docs/claude-sdk-runtime-design.md.
  activity          Json?
  snapshotAt        DateTime?
  // Live preview mounted by the agent (`hermit-preview` CLI → gateway preview
  // module → /api/sync/live-preview). Shape: { url, mode: 'static'|'proxy',
  // target, updatedAt }; null = none. Drives the chat pane's preview FAB +
  // panel. Read by getSession ONLY — never listSessions (per-session payload
  // rule, see chat.ts listSessions' loopState note).
  livePreview       Json?

  // ── Resource governance (docs/resource-governance-design.md) ──
  // Process-tree RSS (claude + mcp-stub + any children) of this session's pane,
  // in MB, latest snapshot. Pushed by the session-snapshot tick; drives the
  // Host-health panel's per-session memory + the reaper's "biggest first" order.
  rssMb                Int?
  // Hibernation: the reaper (idle-TTL) or a manual Hibernate killed this session's
  // pane to free its ~500MB claude process. claudeSessionId + the transcript are
  // kept, so the next user message respawns with `--resume` (history preserved).
  // Distinct from closedAt (user-ended): a hibernated session is "asleep, wakes on
  // send". Cleared by the gateway when it respawns the session.
  hibernatedAt         DateTime?
  // User-requested manual hibernate. Set by chat.requestHibernate; gateway kills
  // the pane + sets hibernatedAt, then clears this (mirrors restartRequestedAt).
  hibernateRequestedAt DateTime?

  // ── Brain dispatch routing (docs/brain-design.md Phase 2) ──
  // When Brain's `dispatch` MCP tool opens this session, it stamps the Brain's
  // OWN chat sessionId here so the gateway dispatch-watcher knows which session to
  // poke when this dispatch finishes or blocks on a choice. NULL = not a Brain
  // dispatch (or a legacy one from before this field existed).
  dispatchedBySessionId String?
  // Dedup marker for the dispatch-watcher: the signature of the last state it
  // already poked the Brain about ("blocked:<interactionId>" | "done:<msgId>" |
  // "working" | "none"). The watcher pokes only on a CHANGE, so it fires once per
  // transition instead of every tick. NULL = never evaluated.
  dispatchNotify        String?

  // ── Brain takeover (docs/brain-takeover-design.md) ──
  // The human hands a NORMAL conversation to the Brain, which then talks to the
  // agent on their behalf until it judges the goal met. Distinct from dispatch:
  // dispatch OPENS a session on a target; takeover joins one the human was already
  // having, so `origin` stays null and the human's own messages remain in place.
  //
  // Non-null = live takeover, and it holds the Brain's OWN chat session id (the
  // poke target), exactly like dispatchedBySessionId above.
  takeoverBySessionId String?
  takeoverStartedAt   DateTime?
  // Messages the Brain has sent in this takeover. chat.send increments it and
  // REFUSES past the cap — the cap is enforced here, not by asking the Brain nicely.
  takeoverTurns       Int       @default(0)
  // What the Brain inferred it is driving toward, shown in the chat banner so the
  // human can see a wrong reading immediately instead of after 12 turns.
  takeoverGoal        String?
  // Dedup marker for the takeover-watcher, same contract as dispatchNotify.
  takeoverNotify      String?
  // What the Brain is CURRENTLY composing, shown ghosted in the composer before it
  // sends. The point is that its turns don't appear fully-formed out of nowhere: you
  // watch the sentence arrive, and those seconds are your window to take the wheel
  // back before it lands. Cleared when the message is written.
  takeoverDraft       String?
  takeoverDraftAt     DateTime?

  // ── Session cleanup (docs/session-cleanup-design.md) ──
  // Recycle bin. Non-null = gone from every list but recoverable; the gateway
  // purges it (row + messages + transcript) once it has sat here longer than the
  // machine's trashRetainDays. Same shape as Agent.trashedAt so there is one
  // trash mental model, not two.
  //
  // Distinct from closedAt, which is "I'm done with this task" — an archived
  // session is a finished thing you might re-read. Trashed is "this context isn't
  // worth keeping", the last stop before the content is actually gone.
  trashedAt   DateTime?
  // Why cleanup put it here ('dispatch-done' | 'stillborn' | 'empty' | 'idle' |
  // 'agent-trashed' | 'manual'). Rendered in the trash view: a wrong call has to
  // be legible at a glance, not reconstructed from timestamps after the fact.
  trashReason String?
  // The user pressed Keep: never propose this session as a cleanup candidate
  // again. Without it, every session you decline gets re-proposed on the next
  // run — any recurring cleanup UI needs a "stop asking me about this one".
  keepAt      DateTime?

  // ── Unanswered-message alert (docs/unanswered-alert-design.md) ──
  // The human's message id this session was flagged on, i.e. the newest message in
  // the conversation was one THEY typed and it went unanswered past the threshold.
  // Set by the sweep when it alerts, cleared the moment any non-human row lands.
  //
  // It is the dedup key, not just a marker: the alert is a TRANSITION, so a session
  // sitting stalled for hours pushes once. A follow-up message has a different id,
  // which re-arms the clock — which is right, since it's a second unanswered ask.
  unansweredMsgId      String?
  // What "mark all read" acknowledged, so the inbox item can be dismissed without
  // the next sweep instantly re-raising it (unansweredMsgId itself must survive —
  // clearing it would re-fire the push). Mirrors HostStat.redAlertAt/alertReadAt.
  unansweredAckedMsgId String?

  messages     ChatMessage[]
  interactions Interaction[]
  liveActivities LiveActivity[]
  cronReports  Cron[]       @relation("CronReports")
  // Which sidebar drawer this session lives in. NULL = ungrouped, i.e. it stays in
  // the flat recency list. SET NULL on delete: removing a drawer must not remove the
  // conversations in it.
  groupId String?
  group   SessionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([machineId, agentName])
  @@index([machineId, closedAt])
  // Resolve a session by its Claude uuid — the interaction-sync fallback lookup
  // (app/api/sync/interaction/route.ts) findFirst WHERE claudeSessionId + machineId.
  @@index([machineId, claudeSessionId])
  // Back the `WHERE machineId ORDER BY lastMessageAt DESC` scans in the always-on
  // sidebar's notifications.counts / notifications.feed (5s, every page) — without it
  // Postgres filesorts the machine's whole session set to take the top 300. See
  // docs/perf-backlog.md P0-1.
  @@index([machineId, lastMessageAt])
  // Four PARTIAL indexes for the sparse request-flag columns — cancelRequestedAt /
  // restartRequestedAt / hibernateRequestedAt / (dispatchedBySessionId + closedAt) —
  // back the gateway's per-~1.5s cancel/restart/hibernate/dispatch pollers. Prisma's
  // @@index can't express a WHERE predicate, so they live as raw
  // `CREATE INDEX ... WHERE <col> IS NOT NULL` in migration
  // 20260715170000_chatsession_poller_indexes (this repo applies migrations via
  // `migrate deploy`, never `migrate dev`).
  //
  // A fifth partial index — (machineId) WHERE unansweredMsgId IS NOT NULL — backs the
  // always-on inbox's stall lookup, which normally matches zero rows. Raw SQL for the
  // same reason, in migration 20260802010000_unanswered_alert.
  //
  // A sixth — (machineId, trashedAt) WHERE trashedAt IS NOT NULL — backs the trash
  // view and the gateway's purge poller, both of which normally match zero rows.
  // Migration 20260809180000_session_cleanup.
  //
  // Every list query now also carries `trashedAt IS NULL`. That is deliberately NOT
  // indexed: it is the ~100% selective side of the predicate, so it costs a filter
  // on rows already fetched, not a scan.
}

// A named, collapsible drawer in the sidebar's session list.
//
// The list is recency-ordered, which is right for "what was I just doing" and wrong
// for 70 open sessions — and cron mailboxes made it worse by bumping themselves to the
// top every time a schedule reported. Groups let the noise be folded away WITHOUT
// giving up the flat recent list: a grouped session leaves the recents, an ungrouped
// one stays exactly where it was.
model SessionGroup {
  id        String   @id @default(cuid())
  machineId String
  machine   Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int      @default(0)
  // Collapsed state lives in the DB, not localStorage: the same person on a phone and
  // a laptop wants the same drawers shut (the ChatSession.lastReadAt precedent).
  collapsed Boolean  @default(true)
  createdAt DateTime @default(now())

  sessions ChatSession[]

  @@index([machineId, sortOrder])
}

model ChatMessage {
  id          String      @id @default(cuid())
  sessionId   String
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        String // user | assistant | system | tool
  // Anthropic content-block array: [{type:'text', text}, {type:'tool_use', id, name, input}, {type:'tool_result', tool_use_id, content}, ...]
  content     Json
  // Used to track delivery state of user messages: null = pending pickup,
  // ISO = gateway picked it up (so gateway doesn't re-deliver on poll).
  deliveredAt DateTime?
  // Anthropic message id (msg_...) if known, useful for dedup on assistant rows.
  externalId  String?
  // Who produced a role='user' row. NULL = the human typed it (also the value on
  // every pre-takeover row, and on gateway-synced assistant/tool/system rows, which
  // aren't user rows at all). 'brain' = the Brain said it during a takeover.
  //
  // Load-bearing in three places: the timeline renders the two visibly differently,
  // the USER.md corpus counts ONLY human rows (else the Brain trains on its own
  // words and drifts into a self-portrait), and the Brain re-reading a conversation
  // it drove can tell its own turns from the human's. Not an authorization
  // boundary — a machine key is trusted; this is provenance.
  authoredBy  String?
  createdAt   DateTime    @default(now())
  // Bumped on every insert AND in-place upsert (the gateway updates a row by
  // externalId as its turn streams). The SSE stream uses MAX(updatedAt) + count
  // as a cheap change signal instead of fetching + stringifying the whole
  // window each 250ms tick — see api/chat/stream/route.ts.
  updatedAt   DateTime    @default(now()) @updatedAt

  // Dedup key for gateway-synced rows (assistant/tool/system blocks carry a
  // stable externalId): lets the chat-message sync route upsert by point-lookup
  // instead of a per-item findFirst heap scan, keeping SDK retries + streaming
  // partials idempotent. externalId is NULL for user-composed rows (created via
  // chat.send), and Postgres treats NULLs as distinct, so those never collide.
  @@unique([sessionId, externalId])
  @@index([sessionId, createdAt])
  @@index([sessionId, deliveredAt])
  @@index([sessionId, updatedAt])
  // The USER.md corpus scan (chat.humanMessages) is machine-wide and time-ordered —
  // "every message the human typed since <watermark>" — which none of the
  // session-keyed indexes above can serve. It needs a PARTIAL index (role='user'
  // AND authoredBy IS NULL) that @@index can't express, so it lives as raw SQL in
  // migration 20260727180000_brain_takeover.
}

// A blocking interaction a running claude turn needs the WEB user to resolve —
// the TUI prompts (permission approval, AskUserQuestion) that render only in the
// local tmux pane and never reach the JSONL, so the dashboard user can't see or
// answer them and the turn hangs. The gateway's permission hook (kind=permission)
// and the mcp__hermit__ask tool (kind=question) create one of these, post a
// matching ChatMessage with a {type:'interaction'} block, then LONG-POLL `status`
// until the user clicks a button (interaction.resolve writes `decision`). Whoever
// is blocked reads `decision` and continues — no TUI ever renders.
model Interaction {
  id         String      @id @default(cuid())
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind       String // "permission" | "question"
  // permission: { tool, input, cwd, claudeSessionId }
  // question:   { question, options: [{label, description?}], multiSelect }
  payload    Json
  status     String      @default("pending") // pending | resolved | canceled
  // permission: { behavior: "allow" | "deny", reason? }
  // question:   { answers: string[] }   (custom free-text answer ⇒ answers:[text])
  decision   Json?
  // Who answered: NULL = the human clicked it, 'brain' = the Brain answered on their
  // behalf (dispatch or takeover). Without this a decision the Brain made looks
  // exactly like one you made, which is precisely the thing you'd want to audit.
  answeredBy String?
  createdAt  DateTime    @default(now())
  resolvedAt DateTime?

  @@index([sessionId, status])
}

// Current "window" usage snapshot. One row per (machineId, kind). Gateway
// upserts these every 5min. Kind ∈ {fiveHour, weekly} for now.
model UsageWindow {
  id          String   @id @default(cuid())
  machineId   String
  machine     Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  kind        String
  startTime   DateTime
  endTime     DateTime
  costUSD     Float
  totalTokens BigInt   @default(0)
  // The split behind totalTokens. Worth storing because the total on its own is
  // alarming and uninformative: ~96% of it is cacheRead — the same context re-counted
  // on every turn — so "190M tokens in 5 hours" means far less new text than it looks.
  inputTokens         BigInt @default(0)
  outputTokens        BigInt @default(0)
  cacheCreationTokens BigInt @default(0)
  cacheReadTokens     BigInt @default(0)
  isActive    Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@unique([machineId, kind])
  @@index([machineId])
}

// An Agent is a *static* workspace folder — its IDENTITY/USER/AGENTS/TOOLS
// markdowns, scheduled tasks, skills, evolution notes. It has NO runtime
// state (no pid, no alive, no ctx). Runtime lives on each ChatSession that
// targets this agent (each gets its own claude inside `hermit-<sessionId>`).
model Agent {
  id                   String    @id @default(cuid())
  machineId            String
  machine              Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  name                 String
  directory            String? // absolute path on the gateway's host
  // The machine's orchestrator ("义脑" / brain): at most one per machine
  // (app-enforced via agents.setOrchestrator). Unlocks the brain-only MCP tools —
  // the gateway sets HERMIT_BRAIN on this agent's sessions so mcp-stub registers
  // roster/agent_activity/dispatch/... A plain dashboard flag; no on-disk effect.
  isOrchestrator       Boolean   @default(false)
  // For the orchestrator only: which BRAIN_TEMPLATE_VERSION its machine-managed
  // files (the `dreaming` skill) were last overlaid at. ensureBrain re-overlays +
  // re-stamps when this is behind, so a brain scaffolded by an older template
  // converges on gateway startup. 0 = pre-versioning / non-brain.
  brainTemplateVersion Int       @default(0)
  // Which backend runs this agent. 'claude-tmux' is interactive `claude` in a
  // tmux pane (the default, and the only path that bills against Claude Max's
  // Interactive bucket — see chat-runner.ts's header). 'pi-rpc' runs pi as an
  // RPC child process against its own provider. Provider/model apply to pi only;
  // claude's model comes from that machine's ~/.claude/settings.json.
  // See docs/pi-runtime-design.md.
  runtime              String    @default("claude-tmux")
  runtimeProvider      String?
  runtimeModel         String?
  // Default pi mode for this agent's new sessions. Only meaningful when runtime
  // is 'pi-rpc'. null = the fleet default ('coding'). See docs/pi-modes-design.md.
  runtimeMode          String?

  // Soft-delete / recycle bin. Set when the agent is moved to trash; cleared on
  // restore. The gateway mv's the dir to AGENTS_ROOT/.hermit-trash/ on delete,
  // back on restore, and rm -rf's it on purge. agents.list hides rows where this
  // is non-null; the trash view lists exactly those.
  trashedAt            DateTime?
  updatedAt            DateTime  @updatedAt

  // Static-metadata blob pushed by the gateway every ~5 min. The detail
  // sheet renders each text as markdown; `skillNames` is a chip list.
  identityText     String?   @db.Text
  userText         String?   @db.Text
  agentsText       String?   @db.Text
  toolsText        String?   @db.Text
  evolutionLessons String?   @db.Text
  skillNames       String[]  @default([])
  // Per-skill SKILL.md contents pushed by the gateway alongside skillNames so
  // the detail sheet can render + edit them. Shape: Array<{name, content}>.
  skills           Json      @default("[]")
  evolutionFiles   Json      @default("[]") // Array<{ path, content }> — evolution/ tree
  memoryFiles      Json      @default("[]") // Array<{ path, content }> — Claude Code auto-memory
  memorySummary    String?   @db.Text
  metadataAt       DateTime?

  @@unique([machineId, name])
  @@index([machineId])
}

// User-defined recurring tasks. Fired by the gateway cron-runner: every fire
// runs the prompt through a FRESH tmux + claude turn in the agent's directory
// (no happy, no `claude -p`) and records a CronRun. Interval-based with an
// optional jitter window so the next fire = lastFire + intervalSec ± random.
model Cron {
  id          String  @id @default(cuid())
  machineId   String
  machine     Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  agentName   String // owning agent dir
  directory   String? // override cwd (default = agent dir)
  title       String? // short label for the list
  prompt      String  @db.Text // the task prompt
  intervalSec Int // base period: fire every N seconds
  jitterSec   Int     @default(0) // ± uniform random applied to each fire
  enabled     Boolean @default(true)

  // Where this cron's report lands. A cron runs ISOLATED — a throwaway pane, so a
  // daily job can't grow a chat's context without bound — but its result should still
  // arrive somewhere you actually read, not only in /cron. Defaults to the session the
  // cron was created from: you asked for it in a conversation, so it reports back
  // there. NULL = /cron only (an older cron, or one deliberately kept quiet).
  reportSessionId String?
  reportSession   ChatSession? @relation("CronReports", fields: [reportSessionId], references: [id], onDelete: SetNull)

  lastFire   DateTime?
  nextFire   DateTime? // lastFire + intervalSec ± jitter; runner reads this
  lastStatus String? // ok | fail | running

  // A cron that iterates toward a goal ends ITSELF: the run prints a lone CRON_DONE
  // line, the gateway strips it and posts { done: true } with the finish, and this is
  // stamped while `enabled` goes false. Two reasons it is not just `enabled = false`:
  // "reached its goal" and "a human paused it" read identically otherwise, and the UI
  // has to say 已完成 vs 已暂停. Cleared on any re-enable, so a revived cron is not
  // permanently labelled done. (This is what replaced the old session-scoped loop —
  // see apps/cli/template/.claude/skills/cron/SKILL.md.)
  doneAt DateTime?

  // ── Same-day catch-up after a failed run ───────────────────────────────────
  //
  // OPT-IN, and it stays that way. A cron that sends mail, publishes or posts is
  // doing something irreversible, and a catch-up run of one of those is a
  // duplicate delivery to real people. finance-agent's scheduler deliberately
  // left its 15:40 digest without a window for exactly this reason (sway's call,
  // 2026-08-31); the shape here is copied from it.
  //
  // NULL on either field = no catch-up, and the row behaves exactly as before.
  retryEverySec  Int? // wait this long after a failure, then run again
  retryWindowSec Int? // ...but never later than firedAt + this. Bounds a real outage
  //                     (a spent quota, a dead credential) to a few wasted runs
  //                     instead of dozens a day.

  // Internal state, not settings. `retryUntil` is stamped from the FIRST failure's
  // fire and then reused, so a catch-up that also fails is still measured against
  // the original schedule rather than sliding its own deadline forward. Both are
  // cleared by any run that does not fail, and by a normal (non-catch-up) fire.
  retryUntil DateTime?
  retryCount Int       @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  runs      CronRun[]

  @@index([machineId, agentName])
}

// One execution of a Cron. The cron detail page reads these for the run log.
model CronRun {
  id         String    @id @default(cuid())
  cronId     String
  cron       Cron      @relation(fields: [cronId], references: [id], onDelete: Cascade)
  firedAt    DateTime  @default(now())
  finishedAt DateTime?
  status     String // running | ok | fail
  output     String?   @db.Text // tail of the run's claude output
  durationMs Int?
  // null = unread → red dot once the run is finished (status ok|fail). A running
  // run is never "unread" (it's amber). Set by cron.markRunRead when the user
  // expands the run, or cron.markAllRead. DB-backed so it syncs across devices.
  readAt     DateTime?

  @@index([cronId, firedAt])
}

// Per-hour usage bucket pushed by the gateway. Rows are unique on
// (machineId, agentName, hourBucket). For weekly / daily views, aggregate at
// query time; for the all-time tile, sum the whole partition.
model UsageHourly {
  id                  String   @id @default(cuid())
  machineId           String
  machine             Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  agentName           String
  hourBucket          DateTime // truncated to UTC hour
  cost                Float    @default(0)
  // `cost` minus what the cache reads in it cost. Cache reads are the same context
  // re-read every turn — ~98% of the tokens, ~60% of the dollars — so this is the
  // number that moves with new work instead of with context size. Falls back to
  // `cost` for a model whose price the gateway couldn't derive.
  costExCacheRead     Float    @default(0)
  inputTokens         BigInt   @default(0)
  outputTokens        BigInt   @default(0)
  cacheCreationTokens BigInt   @default(0)
  cacheReadTokens     BigInt   @default(0)
  sessions            Int      @default(0)

  updatedAt DateTime @updatedAt

  @@unique([machineId, agentName, hourBucket])
  @@index([machineId, hourBucket])
}

// ── Marketplace (fleet-global — NOT machineId-scoped) ────────────────────────
// Shared registry of skills + agent templates across every machine connected to
// this dashboard. See docs/marketplace-design.md.

model MarketSkill {
  id                   String               @id @default(cuid())
  slug                 String               @unique // install handle == .claude/skills/<slug>
  displayName          String
  description          String?              @db.Text
  origin               String               @default("uploaded") // uploaded | github | master-skill.org | manual
  originUrl            String?
  category             String?
  tags                 String[]             @default([])
  latestVersion        String
  publishedByMachineId String?
  publishedByAgent     String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  versions             MarketSkillVersion[]
}

model MarketSkillVersion {
  id                 String      @id @default(cuid())
  marketSkillId      String
  marketSkill        MarketSkill @relation(fields: [marketSkillId], references: [id], onDelete: Cascade)
  version            String
  changelog          String?     @db.Text
  content            String?     @db.Text // SKILL.md (null for bundle-only)
  refs               Json        @default("[]") // Array<{ path, content }> — references/, cli/, sub-skills/
  fileCount          Int         @default(0)
  contentHash        String
  createdAt          DateTime    @default(now())
  createdByMachineId String?

  @@unique([marketSkillId, version])
}

model MarketTemplate {
  id                   String                  @id @default(cuid())
  slug                 String                  @unique
  displayName          String
  description          String?                 @db.Text
  basePersona          String?                 @db.Text
  origin               String                  @default("uploaded") // uploaded(from-agent) | manual
  publishedByMachineId String?
  sourceAgent          String?
  latestVersion        String
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  versions             MarketTemplateVersion[]
}

model MarketTemplateVersion {
  id               String         @id @default(cuid())
  marketTemplateId String
  marketTemplate   MarketTemplate @relation(fields: [marketTemplateId], references: [id], onDelete: Cascade)
  version          String
  changelog        String?        @db.Text
  files            Json           @default("[]") // Array<{ path, content }> — stripped template tree
  includedSkills   String[]       @default([]) // market skill slugs the template installs
  createdAt        DateTime       @default(now())

  @@unique([marketTemplateId, version])
}

// Provenance for agent-level installs (the gateway pushes Agent.skills from disk
// and can't know origin, so the install flow records it dashboard-side).
model AgentSkillInstall {
  id            String   @id @default(cuid())
  machineId     String
  agentName     String
  skillName     String
  marketSkillId String
  marketVersion String
  installedAt   DateTime @default(now())

  @@unique([machineId, agentName, skillName])
}

// An APNs-registered iOS device subscribed to ONE machine's notifications. The
// native shell (apps/ios) never sees a machine key: it hands the device token to
// the web layer, which registers it once per keyring entry through the normal
// authenticated tRPC client — so a phone holding three machine keys gets three
// rows and receives pushes from all three. See docs/ios-shell-design.md.
/// One running Lock Screen / Dynamic Island activity.
///
/// Separate from PushDevice because the token is per-ACTIVITY, not per-device: a
/// phone showing two sessions has two rows and two tokens, each valid only while
/// its activity is alive, and iOS reissues them on its own schedule. The row is
/// created when the app reports the token and deleted when the activity ends or
/// APNs says the token is dead.
model LiveActivity {
  id        String      @id @default(cuid())
  /// APNs activity push token, lowercase hex. Globally unique — the same
  /// activity cannot exist twice.
  token     String      @unique
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// Denormalised from the session so a push can be authorised and addressed
  /// without a join, on a path that runs on every gateway snapshot.
  machineId String
  machine   Machine     @relation(fields: [machineId], references: [id], onDelete: Cascade)
  /// Same sandbox/production split as PushDevice.apnsEnv, and self-healed the
  /// same way (apns.ts retries the other host on BadDeviceToken).
  apnsEnv   String      @default("sandbox")
  /// The last content signature actually pushed. An unchanged tick sends
  /// nothing: Apple budgets high-frequency activity updates and starts dropping
  /// them, and the gateway reports a snapshot every 8 seconds.
  lastSig   String?
  /// The phase the widget is currently showing, and when it began.
  ///
  /// The widget draws its elapsed time from a single start stamp and the system
  /// ticks it — so that stamp must NOT move between updates, or the timer jumps
  /// backwards on screen every time a tool changes. It moves only when the phase
  /// itself does. Seeded from the app's own stamp at registration so the number
  /// does not step when the server takes over.
  phase       String?
  phaseSince  DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([sessionId])
  @@index([machineId])
}

model PushDevice {
  id String @id @default(cuid())
  // Transport-specific device identity, and the unique key alongside machineId:
  //   ios  → APNs device token, lowercase hex
  //   web  → the Web Push endpoint URL (it IS the subscription's identity)
  //   bark → the Bark device key
  token      String
  machineId  String
  machine    Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  // Which wire this row goes out on: 'ios' | 'web' | 'bark'. See
  // src/server/push/transport.ts and docs/no-app-push-design.md.
  platform   String  @default("ios")
  // Which APNs host this token is valid against — decided by the installed build's
  // `aps-environment` entitlement, which the app reads from its embedded provisioning
  // profile and reports at registration. An Xcode-installed build is "sandbox";
  // TestFlight / App Store is "production". Sending to the wrong host fails with
  // BadDeviceToken, so this is NOT guessable server-side. Meaningless for web/bark.
  apnsEnv    String  @default("sandbox")
  // web only — the full PushSubscription: { endpoint, keys: { p256dh, auth } }.
  // `token` duplicates the endpoint so the unique constraint works for every
  // platform; the keys have nowhere else to live and are useless without it.
  subscription Json?
  // bark only — base URL of a self-hosted bark-server. Null = the public
  // api.day.app. Per-device rather than per-machine: two phones can legitimately
  // sit on different servers, and the key is only valid against the one that
  // issued it.
  barkServer String?
  // ios only — the app-wide Live Activity push-to-start token (iOS 17.2+).
  // Distinct from `token`: that one addresses the device for a notification,
  // this one lets the server RAISE a Live Activity on a phone whose app is not
  // running. Null on a device that has never reported one (an older iOS, or a
  // build without the widget extension).
  liveActivityStartToken String?

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  // Re-registering the same device for the same machine is an upsert, not a new
  // row — the app re-registers on every launch (tokens rotate on reinstall).
  @@unique([token, machineId])
  @@index([machineId])
}

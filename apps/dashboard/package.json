{
  "name": "@hermit-ui/dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "build": "next build",
    "build:check": "next build --experimental-build-mode compile",
    "start": "tsx server.ts",
    "next:start": "next start -p ${PORT:-4101}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "gen:ios-contract": "tsx scripts/gen-ios-contract.ts",
    "gen:sync-plan-fixture": "tsx scripts/gen-sync-plan-fixture.ts",
    "gen:search-fixture": "tsx scripts/gen-search-fixture.ts",
    "gen:status-fixture": "tsx scripts/gen-status-fixture.ts",
    "gen:blocks-fixture": "tsx scripts/gen-blocks-fixture.ts",
    "gen:fold-fixture": "TZ=UTC tsx scripts/gen-fold-fixture.ts",
    "gen:merge-fixture": "tsx scripts/gen-merge-fixture.ts",
    "gen:header-fixture": "tsx scripts/gen-header-fixture.ts",
    "gen:composer-fixture": "tsx scripts/gen-composer-fixture.ts",
    "gen:queue-fixture": "tsx scripts/gen-queue-fixture.ts",
    "render:queue-bar": "tsx scripts/render-queue-bar.tsx",
    "render:session-rows": "tsx scripts/render-session-rows.tsx",
    "seed": "tsx scripts/seed-machine.ts",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "test": "tsx --test src/server/*.test.ts src/server/push/*.test.ts src/lib/*.test.ts src/lib/chat-cache/*.test.ts src/components/chat/*.test.ts"
  },
  "dependencies": {
